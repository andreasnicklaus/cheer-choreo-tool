{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --exec tsx src/index.ts",
    "reset": "node src/resetDB.js",
    "docs": "jsdoc -c jsdoc.json",
    "docs:dev": "concurrently --kill-others \"live-server --wait=1000 dist/docs\" \"nodemon --exec npm run docs\"",
    "build": "npm run clean && npm run lint && npm run build:ts",
    "build:ts": "tsc --project compile.tsconfig.json && tsc-alias --project compile.tsconfig.json && tscp --project compile.tsconfig.json",
    "test": "npm run test:prep && npm run test:unit",
    "test:prep": "npm run lint && tsc --noEmit",
    "test:unit": "jest",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasnicklaus/cheer-choreo-tool.git"
  },
  "author": "Andreas Nicklaus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andreasnicklaus/cheer-choreo-tool/issues"
  },
  "homepage": "https://www.choreo-planer.de",
  "dependencies": {
    "@logtail/node": "0.5.11",
    "@logtail/winston": "0.5.11",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/passport": "1.0.17",
    "@types/passport-facebook": "3.0.4",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.17",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "bcrypt": "6.0.0",
    "body-parser": "2.3.0",
    "clean-jsdoc-theme": "5.2.0",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "ejs": "6.0.1",
    "eslint": "9.39.5",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "express-rate-limit": "8.7.0",
    "express-robots-txt": "1.0.0",
    "express-session": "1.19.0",
