    "@types/jest": "30.0.0",
    "@types/node": "25.9.8",
    "@types/sequelize": "6.12.0",
    "concurrently": "10.0.5",
    "jest": "30.5.2",
    "jest-github-actions-reporter": "1.0.3",
    "live-server": "1.2.2",
    "nodemon": "3.1.14",
