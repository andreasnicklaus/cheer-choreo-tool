{
  "plugins": ["plugins/markdown"],
  "source": {
    "include": ["dist"],
    "exclude": ["dist/docs"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "destination": "./dist/docs/",
    "recurse": true,
    "template": "node_modules/clean-jsdoc-theme/dist",
    "encoding": "utf8",
    "readme": "./README.md",
    "verbose": true,
    "siteName": "Choreo Planer",
    "basePath": "./docs/",
    "customCss": "img[alt='Choreo Planer Icon'] { max-width: 200px !important; height: auto !important; } main p:has(> img) { text-align: center !important; }",
    "menu": [
      {
        "id": "home",
        "title": "choreo-planer.de",
        "href": "https://www.choreo-planer.de",
        "target": "_blank"
      },
      {
        "id": "api-docs",
        "title": "API Documentation",
        "href": "/api-docs",
        "target": "_blank"
      },
      {
        "id": "frontend-docs",
        "title": "Frontend Documentation",
        "href": "https://www.choreo-planer.de/docs",
        "target": "_blank"
      }
    ]
  },
  "markdown": {
    "hardwrap": false,
    "idInHeadings": true
  }
}
