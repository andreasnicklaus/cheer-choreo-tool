<!DOCTYPE html>
<html lang="<%= locals.locale ? locale : 'en' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <main>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <form method="post" action="<%= actionUrl %>">
        <button type="submit"><%= submitLabel %></button>
      </form>
    </main>
  </body>
</html>
