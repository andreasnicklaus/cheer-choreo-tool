{
  "plugins": [
    "node_modules/jsdoc-vuejs",
    "plugins/fix-memberof",
    "plugins/markdown",
    "scripts/jsdoc-strip-types.js"
  ],
  "source": {
    "include": [
      "src"
    ],
    "exclude": [
      "public/docs"
    ],
    "includePattern": "\\.(vue|[jt]s)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "opts": {
    "destination": "./public/docs/",
    "recurse": true,
    "template": "./node_modules/clean-jsdoc-theme/dist",
    "encoding": "utf8",
    "readme": "./README.md",
    "verbose": true,
    "siteName": "Choreo Planer",
    "basePath": "./docs/",
    "customCss": "img[alt='Choreo Planer Icon'] { max-width: 200px !important; height: auto !important; } main p:has(> img) { text-align: center !important; }",
    "menu": [
      {
        "id": "api-docs",
        "title": "API Documentation",
        "href": "https://api.choreo-planer.de/api-docs",
        "target": "_blank"
      },
      {
        "id": "server-docs",
        "title": "Server Documentation",
        "href": "https://api.choreo-planer.de/docs",
        "target": "_blank"
      }
    ]
  },
  "markdown": {
    "hardwrap": false,
    "idInHeadings": true
  }
}