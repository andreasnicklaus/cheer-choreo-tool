{
  "name": "choreo-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run icons && vite",
    "build": "npm run icons && npm run docs && npm run build:vite && npm run sw:alias && npm run prerender && npm run sitemap",
    "build:vite": "vite build",
    "sw:alias": "node scripts/publish-sw-alias.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "icons": "vue-asset-generate -a ./public/Icon.png && vue-asset-generate -a ./public/Icon-Dark.png -o ./temp-icons --no-manifest && node scripts/copy-dark-favicon.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "concurrently --kill-others \"live-server ./public/docs\" \"nodemon --exec npm run docs\"",
    "docs:update": "nodemon --exec npm run docs",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test:pretest": "npm run lint && npm run typecheck && npm run format:check",
    "test:e2e": "npm run test:pretest && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "npm run test:pretest && vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@logtail/browser": "0.5.11",
    "@unhead/vue": "3.4.2",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "axios-cache-interceptor": "1.12.3",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "bootstrap-vue-next": "1.2.2",
    "gsap": "3.15.0",
    "javascript-time-ago": "2.6.4",
    "js-cookie": "3.0.8",
    "register-service-worker": "1.7.2",
    "unleash-proxy-client": "3.8.2",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-matomo": "4.2.0",
    "vue-router": "5.3.1",
    "vue3-country-flag-icon": "0.1.2",
    "vue3-html2pdf": "1.1.2",
    "vue3-markdown-it": "1.0.10",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-typescript": "7.29.7",
    "@estruyf/github-actions-reporter": "1.12.0",
    "@iconify-json/bi": "1.2.7",
    "@playwright/test": "1.63.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "25.9.9",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/tsconfig": "0.9.1",
    "clean-jsdoc-theme": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "html-minifier-terser": "7.2.0",
    "jsdoc": "4.0.5",
    "jsdoc-vuejs": "4.0.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "puppeteer": "^25.0.0",
    "sass": "1.105.1",
    "sass-embedded": "1.105.1",
    "serve": "14.2.6",
    "sitemap-generator": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "vue-pwa-asset-generator": "1.7.3",
    "vue-tsc": "3.3.11"
  },
  "nodemonConfig": {
    "ignore": [
      "./public/docs"
    ],
    "ext": "vue,js,ts,md"
  },
  "overrides": {
    "node-sass": "npm:sass@1.105.1",
    "jspdf": "4.2.1",
    "dompurify": ">=3.4.11",
    "esbuild": "0.28.2"
  }
}
